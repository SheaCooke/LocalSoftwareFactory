# Normalize line endings: LF in the repo, native on checkout for text files.
* text=auto eol=lf

# Windows-native scripts keep CRLF so PowerShell and cmd are happy.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts and the sandbox Dockerfile must stay LF or bash/sh inside WSL breaks.
*.sh text eol=lf
Dockerfile text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.db binary
