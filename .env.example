# Copy to .env and fill in only the providers you use. .env is git-ignored.
# Keys can also come from real environment variables or Windows Credential
# Manager (install the `keyring` extra; service name "software-factory",
# username = the variable name below).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
